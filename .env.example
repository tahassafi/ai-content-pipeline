# ===== General =====
# Public HTTPS base URL where this app is served (Meta webhooks require HTTPS)
BASE_URL=https://agent.yourdomain.com
# Master password for the dashboard (also works as an "admin" fallback login)
DASHBOARD_PASSWORD=change-me
# Random secret for signing session cookies (generate: openssl rand -hex 32)
SESSION_SECRET=change-me-too
# IANA timezone used for scheduling and rate windows
TIMEZONE=UTC

# ===== Claude API =====
# Anthropic API key used for all caption/reply generation
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Claude model to use
CLAUDE_MODEL=claude-sonnet-5
# approve = every AI reply waits for human approval | auto = replies send themselves
REPLY_MODE=approve

# ===== Reply safety caps (per brand + platform) =====
# Max auto-replies per hour before further replies are held for approval
MAX_REPLIES_PER_HOUR=12
# Max auto-replies per day
MAX_REPLIES_PER_DAY=60
# Max replies to the same commenter per day (prevents bot-like behavior)
MAX_REPLIES_PER_COMMENTER_DAY=2
# Random human-like delay range (seconds) before sending a comment reply
REPLY_DELAY_MIN=25
REPLY_DELAY_MAX=75
# Random delay range (seconds) before sending a DM reply
DM_DELAY_MIN=5
DM_DELAY_MAX=20

# ===== Public contact details (inserted into generated captions) =====
# Phone number shown in caption contact blocks
CONTACT_PHONE=+0 000 000 0000
# Email shown in caption contact blocks
CONTACT_EMAIL=contact@example.com
# Website shown in caption contact blocks
WEBSITE_URL=https://example.com
# Instagram handle shown in caption contact blocks (with @)
IG_HANDLE=@yourdealership
# WhatsApp deep link used in DM replies
WHATSAPP_LINK=https://wa.me/00000000000
# Local-currency-to-USD rate used to compute USD prices in captions
USD_RATE=3.65

# ===== DMs =====
# Enable auto-handling of Instagram/Messenger/Marketplace DMs
DM_ENABLED=true
# Optional fallback: site search URL for availability checks; {query} = car name
INVENTORY_SEARCH_URL=

# ===== Inventory database (read-only; preferred availability source) =====
# MySQL host of the dealership website's database
MYSQL_HOST=localhost
# Database name (leave empty to disable DB-backed availability checks)
MYSQL_DB=
# A READ-ONLY MySQL user (GRANT SELECT on the cars table only)
MYSQL_USER=
# That user's password
MYSQL_PASSWORD=
# Table holding the vehicle inventory
MYSQL_CARS_TABLE=cars

# ===== Meta app (one developer app serves all brands' pages) =====
# App ID from developers.facebook.com > Settings > Basic
META_APP_ID=
# App Secret from the same page (keep private; used to verify webhook signatures)
META_APP_SECRET=
# Any random string; must match the token entered in the Meta webhook config
META_VERIFY_TOKEN=choose-a-random-verify-token
# Graph API version to call
GRAPH_API_VERSION=v21.0

# ===== YouTube =====
# Master switch for YouTube comment polling
YT_ENABLED=false
# OAuth client secret JSON downloaded from Google Cloud (used by scripts/yt_auth.py)
YT_CLIENT_SECRET_FILE=data/yt_client_secret.json
# Minutes between YouTube comment polls
YT_POLL_MINUTES=5

# ===== Brands =====
# Comma-separated brand keys; each key gets its own BRAND_<KEY>_* variables below
BRANDS=brand_one

# --- Brand One (duplicate this block per brand, e.g. BRAND_BRAND_TWO_*) ---
# Display name in the dashboard
BRAND_BRAND_ONE_NAME=Brand One
# The brand voice: everything the AI should know when writing as this brand
BRAND_BRAND_ONE_VOICE=Describe the business, what it sells, tone of voice, what to never say (e.g. never quote prices), languages to reply in, and where to send serious buyers.
# Facebook Page ID for this brand
BRAND_BRAND_ONE_META_PAGE_ID=
# Long-lived Page access token for this brand's Page
BRAND_BRAND_ONE_META_PAGE_TOKEN=
# Instagram Business account ID linked to that Page
BRAND_BRAND_ONE_IG_USER_ID=
# Instagram username (used for collab invites)
BRAND_BRAND_ONE_IG_USERNAME=
# YouTube channel ID (starts with UC...)
BRAND_BRAND_ONE_YT_CHANNEL_ID=
# Path to this brand's YouTube OAuth token (created by scripts/yt_auth.py)
BRAND_BRAND_ONE_YT_TOKEN_FILE=data/yt_token_brand_one.json
# Accent color in the dashboard
BRAND_BRAND_ONE_COLOR=#2d5bff
# Branded hashtag always appended as the 5th Instagram hashtag
BRAND_BRAND_ONE_HASHTAG=#YourDealership
# Optional link that must open every Facebook caption for this brand (e.g. a group)
BRAND_BRAND_ONE_FB_PREFIX_LINK=
